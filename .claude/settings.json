{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__solidcraft__(execute|batch|export)",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/dxf_check.sh",
            "timeout": 60,
            "statusMessage": "Checking exported DXF"
          }
        ]
      }
    ]
  }
}
